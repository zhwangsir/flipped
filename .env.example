# 复制为 .env 并填实际值（.env 已在 .gitignore，绝不入库 — AGENTS.md §7）

# exo 上游鉴权 key。exo 内网通常无鉴权 -> 填 dummy 占位即可（切勿留空字符串，否则部分 SDK 报错）
EXO_API_KEY=dummy

# LiteLLM 代理对外 master key。本地生成强随机串：openssl rand -hex 24
LITELLM_MASTER_KEY=sk-CHANGE-ME

# ---------- OpenHands SDK Worker（B2/B4） ----------
# agent-server 地址（Docker 容器运行时为 localhost:8000）
OPENHANDS_AGENT_HOST=http://localhost:8000
# Worker 直连 exo 的模型名（必须带 openai/ provider 前缀）
OPENHANDS_MODEL=openai/mlx-community/Kimi-K2.7-Code-4bit
# exo OpenAI 兼容端点
OPENHANDS_BASE_URL=http://100.64.201.37:52415/v1

# ---------- orchestrator Supervisor/Overseer（B4） ----------
# M131 模型分工：GLM-5.2 为主模型（编排者/架构师），Kimi-K2.7-Code 为执行者/监控者
# GLM-5.2：1M 上下文、深度推理(reasoning)质量高，适合全局编排和任务分解
# Kimi-K2.7-Code：代码生成完整(质量优先模式下 json_parser 7/7 通过)、速度快、稳定性好，适合执行和监控
# 若 LiteLLM proxy 不可用，可设置以下变量让编排者直连 exo
# FLIPPED_MODEL_BASE_URL=http://100.64.201.37:52415/v1
# FLIPPED_ARCHITECT_MODEL=mlx-community/GLM-5.2-fp8
# FLIPPED_CODER_MODEL=mlx-community/Kimi-K2.7-Code-4bit
# FLIPPED_SUPERVISOR_MODEL=mlx-community/Kimi-K2.7-Code-4bit
# FLIPPED_OVERSEER_MODEL=mlx-community/Kimi-K2.7-Code-4bit
# FLIPPED_MONITOR_MODEL=mlx-community/Kimi-K2.7-Code-4bit

# M131 质量优先配置（用户要求：不追求速度，不限制 max_tokens 和超时，只追求质量和完整）
# - enable_thinking=True：开启深度推理（reasoning_content 独立字段不占 content 预算）
# - 不传 max_tokens：让模型自然完成，不人为截断
# - 超时只作为极端兜底防无限挂起，Kimi overseer 监控防真卡死
# GLM-5.2 architect 超时（秒），默认 1800s（30分钟）
# FLIPPED_GLM_TIMEOUT=1800
# Worker(Kimi)整体任务超时（秒），默认 3600s（1小时）
# FLIPPED_WORKER_TIMEOUT=3600
# Worker(Kimi)单次 LLM 调用超时（秒），默认 1800s（30分钟）
# FLIPPED_WORKER_LLM_TIMEOUT=1800
# Worker(Kimi)最大迭代次数，默认 200（质量优先，给复杂任务充足空间）
# FLIPPED_WORKER_MAX_ITERATIONS=200

# ---------- Console（B3） ----------
# 前端构建时 Vite 会注入；运行时不填则默认 http://127.0.0.1:8001
# VITE_API_BASE_URL=http://127.0.0.1:8001

# ---------- RAG (M4) ----------
# 向量库存储目录，默认 data/rag（相对项目根）
# RAG_DB_DIR=data/rag
# 嵌入模型，默认 sentence-transformers/all-MiniLM-L6-v2；未安装则 fallback 到 mock 嵌入
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
