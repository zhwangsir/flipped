{
  "name": "flipped-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "flipped 桌面壳(Electron)— 内嵌 Console + 拉起后端 + 连 OpenHands 沙盒",
  "main": "main.js",
  "scripts": {
    "build:console": "cd ../console && VITE_API_BASE_URL=http://127.0.0.1:8011 npm run build",
    "start": "electron .",
    "dev": "npm run build:console && electron .",
    "dist": "npm run build:console && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.flipped.desktop",
    "productName": "flipped",
    "files": ["main.js", "preload.js"],
    "extraResources": [{ "from": "../console/dist", "to": "console-dist" }],
    "directories": { "output": "release" },
    "mac": { "category": "public.app-category.developer-tools", "target": "dmg" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
